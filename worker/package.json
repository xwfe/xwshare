{
  "name": "xwshare-worker",
  "version": "1.0.0",
  "scripts": {
    "dev": "wrangler dev --var ENVIRONMENT:development --var ADMIN_PASSWORD:xwshare-dev --port 8787",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:init": "wrangler d1 execute xwshare-db --remote --file=src/db/schema.sql",
    "db:init:local": "wrangler d1 execute xwshare-db --local --file=src/db/schema.sql",
    "db:migrate:local": "wrangler d1 execute xwshare-db --local --file=src/db/migrate-pending.sql",
    "db:migrate": "wrangler d1 execute xwshare-db --remote --file=src/db/migrate-pending.sql"
  },
  "dependencies": {
    "hono": "^4.5.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240729.0",
    "typescript": "^5.5.4",
    "wrangler": "^3.67.1"
  }
}
