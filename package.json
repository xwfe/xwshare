{
  "name": "xwshare",
  "version": "2.4.0",
  "private": true,
  "author": "xwfe",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/xwfe/xwshare.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-s check:architecture type-check build-only",
    "build:production": "pnpm run preflight:production && pnpm build",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "check:architecture": "node scripts/check-architecture.mjs",
    "ci:verify": "pnpm build && pnpm --dir worker run typecheck && pnpm --dir worker test",
    "preflight:production": "node scripts/preflight-production.mjs",
    "deploy:pages": "pnpm run build:production && pnpm --dir worker exec wrangler pages deploy ../dist --project-name xwshare",
    "lint": "eslint . --fix",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "dompurify": "^3.4.16",
    "file-saver": "^2.0.5",
    "jszip": "3.10.2",
    "lucide-vue-next": "^0.535.0",
    "marked": "^16.4.2",
    "pinia": "^3.0.4",
    "qrcode.vue": "^3.11.0",
    "vue": "^3.5.43",
    "vue-i18n": "^9.14.5",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/config-array": "^0.23.5",
    "@eslint/js": "^9.39.4",
    "@eslint/object-schema": "^2.1.7",
    "@rushstack/eslint-patch": "^1.16.1",
    "@tsconfig/node20": "^20.1.10",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^24.13.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.4",
    "eslint-plugin-vue": "^10.11.1",
    "glob": "^13.0.6",
    "npm-run-all2": "^8.0.4",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "rimraf": "^6.1.3",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.8.3",
    "vite": "^7.3.5",
    "vue-tsc": "^3.3.11"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "brace-expansion": "5.0.6",
    "esbuild": "0.28.1",
    "form-data": "4.0.6",
    "js-yaml": "4.2.0",
    "shell-quote": "1.8.4",
    "yaml": "2.9.0"
  }
}
